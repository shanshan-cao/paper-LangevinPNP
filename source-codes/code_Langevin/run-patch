    continue
  }
  cd ..

  echo 'running HQ hadronization'
  cd fragPLUSrecomb
  export ftn20=../results2/HMnoHIaa.dat.$i
  time ./fragPLUSrecomb < ../results1/HQaa.dat.$i || {
    warning "hadronization failed for event, skipping to next event"
    continue
  }
