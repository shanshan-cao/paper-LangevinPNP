      parameter (Tstart=0.1)
      parameter (qstart=0.0)
      double precision Tdelta, qdelta
      parameter (Tdelta=0.01)
      parameter (qdelta=0.01)

      double precision a_md, b_md, alphasprime, sigmaprime, cs, cb
