      double precision  C_F,N_c,hbarc,fixAlphas,C_A
      parameter (N_c=3.d0)
      parameter (C_F=4.d0/3.d0)
      parameter (hbarc=0.1973d0)
      parameter (fixAlphas=0.3d0)
      parameter (C_A=3d0)

      double precision A2q(1:101,1:1000000)
