      parameter (m1=1.27d0)
c      parameter (m1=4.19d0)
      parameter (m2=0d0)
      parameter (m3=1.27d0)
c      parameter (m3=4.19d0)
      parameter (m4=0d0)
      parameter (alpha=0.3d0)
      parameter (dofG=16d0,dofQ=6d0)

      integer nt,np
